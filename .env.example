APP_NAME=Drop
APP_ENV=local
DEBUG=false
DATABASE_URL=postgresql+asyncpg://drop:drop@localhost:5432/drop

RABBITMQ_URL=amqp://drop:dropdropdrop@localhost:5672//
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=drop
S3_SECRET_KEY=dropdropdrop
S3_BUCKET=drop
S3_REGION=us-east-1

MAX_UPLOAD_SIZE_BYTES=104857600

DROP_TOKEN_PEPPER=change_this_token_pepper_in_production
SESSION_PEPPER=change_this_session_pepper_in_production

TRUSTED_PROXY_IPS=
SESSION_COOKIE_SECURE=false
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_WINDOW=60
RATE_LIMIT_METADATA_MAX=60
RATE_LIMIT_METADATA_WINDOW=60
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_DOWNLOAD_WINDOW=60
RATE_LIMIT_INVALID_TOKEN_MAX=10
RATE_LIMIT_INVALID_TOKEN_WINDOW=60
RATE_LIMIT_INVALID_TOKEN_BAN_SECONDS=600
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_UPLOAD_BYTES=524288000
RATE_LIMIT_UPLOAD_BYTES_WINDOW=3600
RATE_LIMIT_DOWNLOAD_PER_DROP_MAX=5
RATE_LIMIT_DOWNLOAD_PER_DROP_WINDOW=60
RATE_LIMIT_DOWNLOAD_PER_SESSION_MAX=10
RATE_LIMIT_DOWNLOAD_PER_SESSION_WINDOW=60
DOWNLOAD_STREAM_LOCK_SECONDS=300
PUBLIC_BASE_URL=http://localhost:4917
GRAFANA_ADMIN_PASSWORD=change_this_grafana_admin_password
